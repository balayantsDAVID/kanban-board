# Copy to .env for local development. Never commit a filled-in .env.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Infra (compose service names as hosts) ---
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-random-32-char-secret
SESSION_TTL_DAYS=30
WEB_URL=http://localhost:8080
COOKIE_SECURE=false

# --- App ---
APP_TZ=Asia/Yerevan
LOG_LEVEL=info
LOG_FORMAT=json

# --- AI: transcriber = faster_whisper | openai | fake ---
TRANSCRIBER=faster_whisper
WHISPER_MODEL=small
WHISPER_THREADS=4
WHISPER_LANGUAGE=
VOICE_MAX_SEC=300

# --- AI: extractor = rules | llm | fake ---
EXTRACTOR=rules

# Only needed if TRANSCRIBER=openai or EXTRACTOR=llm
OPENAI_API_KEY=

# --- Build metadata, set by CI/Docker build args ---
VERSION=dev
COMMIT_SHA=local
BUILD_TIME=
